# Production URL of the Express API. Leave empty in development: Vite proxies /api to localhost:4000.
VITE_API_URL=

# Public site URL, used for canonical links, Open Graph and JSON-LD
VITE_SITE_URL=https://yourdomain.com

# Shown on the Contact page and in the footer
VITE_CONTACT_EMAIL=hello@yourdomain.com
# [PLACEHOLDER] Calendly / Cal.com link. Leave empty to hide the booking button.
VITE_BOOKING_URL=

# Supabase: Project Settings > API. Use the ANON (public) key here, never the service-role key.
# Only the /admin page uses these (sign-in + reading leads through Row Level Security).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
